################################################################################
# Forge Sprint - Root .gitignore
################################################################################

############################
# OS Files
############################
.DS_Store
Thumbs.db
Desktop.ini

############################
# IDEs
############################
.vscode/
.idea/
*.iml

############################
# Logs
############################
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

############################
# Environment Variables
############################
.env
.env.*
!.env.example

############################
# Node
############################
**/node_modules/
npm-cache/
.pnpm-store/

############################
# Frontend (Vite)
############################
frontend/dist/
frontend/.vite/
frontend/coverage/

############################
# Laravel
############################
backend/vendor/
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/testing/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore

############################
# Databases
############################
*.sqlite
*.db
*.db-journal

############################
# Docker
############################
docker-data/
postgres_data/

############################
# Build Output
############################
dist/
build/
coverage/

############################
# Temporary Files
############################
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

############################
# Testing
############################
.phpunit.result.cache

############################
# Cache
############################
.cache/
.eslintcache

############################
# Python (if used later)
############################
__pycache__/
*.pyc

############################
# OpenClaw / Hermes
############################
.openclaw/
*.session
*.transcript

############################
# Secrets
############################
*.pem
*.key
*.crt
*.p12
*.pfx

############################
# Miscellaneous
############################
*.seed